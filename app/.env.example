# RepoDvP address printed by script/deploy/DeployAll.s.sol. The tokens, oracle and identity
# registry are read from the contract, so this is the only address the console needs.
VITE_REPO_DVP=
# Sepolia RPC (Alchemy, Infura…). Falls back to a public endpoint when empty, which may rate-limit.
VITE_RPC_URL=
# VITE_DEPLOY_BLOCK printed by DeployAll. Event history is scanned from here; when 0 the console
# finds the deployment block itself (needs an RPC that serves historical state).
VITE_DEPLOY_BLOCK=0
